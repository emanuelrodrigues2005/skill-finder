# -----------------------------------------------------------------------------
# .env.example — copie para `.env` e preencha. `.env` nunca entra no Git.
# TODAS as chaves e NENHUM valor (verificado no checklist da F2.2).
# Nomes em `docs/app/02-arquitetura.md` §3; defaults em `backend/src/config/env.schema.ts`.
# -----------------------------------------------------------------------------

# --- Ambiente ---
# dev ou prod (prod exige DATABASE_URL, LLM_API_KEY com a LLM ligada e IP_HASH_SALT).
# O compose fixa ENV por profile (`api-dev`=dev, `api`=prod) e ignora esta linha;
# ela vale para `pnpm start:dev` na máquina. Com NODE_ENV=production, ENV!=prod
# aborta o boot.
# NODE_ENV: dev na maquina; a imagem de runtime define production (o guard acima le esta chave).
NODE_ENV=
ENV=
# debug, info, warn ou error
LOG_LEVEL=

# --- Banco ---
# Formato: postgresql://usuario:senha@host:5432/banco
# Prisma não aceita sufixo de driver (+psycopg, +asyncpg).
DATABASE_URL=

# --- LLM (compatible com OpenAI, via opencode) ---
# Base URL sem /chat/completions: o cliente acrescenta o caminho
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# true ou false; false força modo degradado
LLM_ENABLED=
# segundos por chamada (default 8)
LLM_TIMEOUT_S=
# teto de tempo SOMADO das chamadas de LLM numa busca, em ms (default 7000).
# A intencao recebe ate 3000 e a explicacao ate 4000 do que sobrar; abaixo de
# 800 ms restantes a explicacao nao e tentada (a resposta sai pelo template).
LLM_TOTAL_DEADLINE_MS=

# --- Fonte do catálogo (skills.sh) ---
# json, html ou fixture (fixture é o padrão offline)
SKILL_SOURCE_KIND=
SKILL_SOURCE_BASE_URL=
SKILL_SOURCE_RPS=

# --- Pesos do ranking (determinístico; a LLM não ordena) ---
RANK_W_STARS=
RANK_W_VULNS=
RANK_W_INSTALLS=

# --- Limites por cliente ---
RATE_LIMIT_SEARCH_PER_MIN=
RATE_LIMIT_SEARCH_PER_DAY=

# --- Privacidade do histórico ---
# true guarda o texto da consulta; false (padrão) guarda só o hash
SEARCH_LOG_STORE_TEXT=
# Sal para pseudonimizar o IP no rate limit (obrigatório em prod)
IP_HASH_SALT=

# --- Ingestão manual (admin, #49) ---
# Token do header X-Admin-Token de POST /admin/ingest (/api/v1/admin/ingest),
# 1 a 20 source_keys por chamada. Obrigatório em prod: sem ele o boot recusa.
# Em dev, sem ele a rota responde 401 (falha fechada) — nunca fica aberta.
ADMIN_TOKEN=

# --- Somente o compose.yaml (não são lidas pela API) ---
POSTGRES_USER=
# Obrigatória: sem ela `docker compose` falha na interpolação (exit != 0) em vez
# de subir um Postgres que morre em silêncio com senha vazia.
POSTGRES_PASSWORD=
POSTGRES_DB=
