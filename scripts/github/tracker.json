{
    "milestones":  [
                       {
                           "title":  "F0 — Pré-requisitos e sandbox",
                           "description":  "Provar máquina, conta e credenciais antes de desenhar qualquer coisa: AWS CLI, Terraform \u003e= 1.10, Docker Compose, Node 22/pnpm e a checklist K1–K14 do sandbox AWS Academy, com evidência datada."
                       },
                       {
                           "title":  "F1 — Proposta e decisões",
                           "description":  "Congelar problema, funcionalidades, arquitetura preliminar e tecnologias (entregável E1) e obter a aprovação do professor antes de gastar esforço em código."
                       },
                       {
                           "title":  "F2 — Aplicação",
                           "description":  "MVP do Skill Finder rodando local no Compose: contrato OpenAPI, catálogo ingerido, ranking determinístico, intérprete de intenção com provedor fake, endpoints de busca/detalhe, 3 telas em inglês e testes em três níveis."
                       },
                       {
                           "title":  "F3 — Infraestrutura como código",
                           "description":  "Provisionar por Terraform com estado remoto no S3: EC2 t3.small, EBS gp3, ECR, security group e as 4 saídas do seam; app respondendo em HTTP e destruível sem órfãos."
                       },
                       {
                           "title":  "F4 — Pipeline CI/CD",
                           "description":  "Ciclar sem passo manual: ci.yml (lint, 3 níveis de teste, gitleaks) e deploy.yml (preflight, build+push no ECR por SHA, tf-plan, deploy por SSH, smoke), com o gate de testes visível no grafo de jobs."
                       },
                       {
                           "title":  "F5 — Observabilidade e segredos",
                           "description":  "Métrica, log e dashboard vivos no host (Prometheus, Loki, Promtail, Grafana, Telegraf, cAdvisor, node-exporter) e nenhum segredo rastreável: .env gerado pelo Infisical, chmod 600, ::add-mask::."
                       },
                       {
                           "title":  "F6 — Entrega",
                           "description":  "Fechar a documentação técnica (E5), endurecer a operação e ensaiar a demo até o ciclo completo ser reprodutível: destroy→apply→deploy→smoke em \u003c 15 min e demo de 3 min."
                       }
                   ],
